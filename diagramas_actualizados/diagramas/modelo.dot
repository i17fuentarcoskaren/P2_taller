digraph G {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.55, fontname="Helvetica", dpi=170, bgcolor="white"];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", color="#334155"];
  Contrato [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Cotizable</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+TASA_IMPUESTO: double</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+clave(): Folio</I><BR ALIGN="LEFT"/><I>+nombre(): String</I><BR ALIGN="LEFT"/><I>+precioBase(): double</I><BR ALIGN="LEFT"/><I>+tarifa(u: int): double</I><BR ALIGN="LEFT"/>+tarifaConImpuesto(u: int): double «default»<BR ALIGN="LEFT"/><U>+porNombre(): Comparator</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CAP1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>ConGarantia</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+mesesGarantia(): int</I><BR ALIGN="LEFT"/>+descripcionCorta(): String «default»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CAP2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Certificable</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+norma(): String</I><BR ALIGN="LEFT"/>+descripcionCorta(): String «default»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Base [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FEF3C7" CELLPADDING="4"><FONT POINT-SIZE="9">«abstract sealed»</FONT><BR/><I><B>Concepto</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-clave: Folio<BR ALIGN="LEFT"/>-nombre: String<BR ALIGN="LEFT"/>-precioBase: double<BR ALIGN="LEFT"/>-creadoEn: LocalDateTime<BR ALIGN="LEFT"/>-cotizaciones: int «transient»<BR ALIGN="LEFT"/><U>-INSTANCIAS_CREADAS: AtomicInteger</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">#Concepto(prefijo, nombre, precio)<BR ALIGN="LEFT"/>#Concepto(clave, nombre, precio)<BR ALIGN="LEFT"/>+clave(): Folio «final»<BR ALIGN="LEFT"/>+nombre(): String «final»<BR ALIGN="LEFT"/>+precioBase(): double «final»<BR ALIGN="LEFT"/>+creadoEn(): LocalDateTime<BR ALIGN="LEFT"/>+cotizaciones(): int<BR ALIGN="LEFT"/>+tarifa(u: int): double «final»<BR ALIGN="LEFT"/><I>#calcularTarifa(u: int): double</I><BR ALIGN="LEFT"/><I>+copiar(): Concepto</I><BR ALIGN="LEFT"/>+setNombre(n: String)<BR ALIGN="LEFT"/>+setPrecioBase(p: double)<BR ALIGN="LEFT"/>+tipo(): String<BR ALIGN="LEFT"/><U>+instanciasCreadas(): int</U><BR ALIGN="LEFT"/>+equals / hashCode «final»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  S1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FEF3C7" CELLPADDING="4"><FONT POINT-SIZE="9">«static final»</FONT><BR/><B>Concepto.Refaccion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+PREFIJO = "REF"</U><BR ALIGN="LEFT"/>-marca: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+Refaccion(nombre, precio, marca: String)<BR ALIGN="LEFT"/>+Refaccion(clave, nombre, precio, marca)<BR ALIGN="LEFT"/>+marca(): String<BR ALIGN="LEFT"/>+mesesGarantia(): int<BR ALIGN="LEFT"/>#calcularTarifa(u: int): double<BR ALIGN="LEFT"/>+copiar(): Refaccion<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  S2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FEF3C7" CELLPADDING="4"><FONT POINT-SIZE="9">«static final»</FONT><BR/><B>Concepto.ManoDeObra</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+PREFIJO = "MOB"</U><BR ALIGN="LEFT"/>-nivelTecnico: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+ManoDeObra(nombre, precio, nivelTecnico: int)<BR ALIGN="LEFT"/>+ManoDeObra(clave, nombre, precio, nivelTecnico)<BR ALIGN="LEFT"/>+nivelTecnico(): int<BR ALIGN="LEFT"/>+norma(): String<BR ALIGN="LEFT"/>#calcularTarifa(u: int): double<BR ALIGN="LEFT"/>+copiar(): ManoDeObra<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  S3 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FEF3C7" CELLPADDING="4"><FONT POINT-SIZE="9">«static final»</FONT><BR/><B>Concepto.Diagnostico</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+PREFIJO = "DIA"</U><BR ALIGN="LEFT"/>-equipo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+Diagnostico(nombre, precio, equipo: String)<BR ALIGN="LEFT"/>+Diagnostico(clave, nombre, precio, equipo)<BR ALIGN="LEFT"/>+equipo(): String<BR ALIGN="LEFT"/>+mesesGarantia(): int<BR ALIGN="LEFT"/>+norma(): String<BR ALIGN="LEFT"/>#calcularTarifa(u: int): double<BR ALIGN="LEFT"/>+copiar(): Diagnostico<BR ALIGN="LEFT"/>+descripcionCorta(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Clave [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DCFCE7" CELLPADDING="4"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>Folio</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">prefijo: String<BR ALIGN="LEFT"/>numero: int<BR ALIGN="LEFT"/><U>-SECUENCIAS: Map&lt;String, AtomicInteger&gt;</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+siguiente(prefijo): Folio</U><BR ALIGN="LEFT"/><U>+registrar(c: Folio)</U><BR ALIGN="LEFT"/><U>+parse(texto): Folio</U><BR ALIGN="LEFT"/>+compareTo(o): int<BR ALIGN="LEFT"/>+toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Nivel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DCFCE7" CELLPADDING="4"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Nivel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">OCASIONAL (0%)<BR ALIGN="LEFT"/>FRECUENTE (8%)<BR ALIGN="LEFT"/>FLOTILLA (15%)<BR ALIGN="LEFT"/>-etiqueta: String<BR ALIGN="LEFT"/>-descuento: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+etiqueta(): String<BR ALIGN="LEFT"/>+descuento(): double<BR ALIGN="LEFT"/>+aplicar(monto): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Estado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DCFCE7" CELLPADDING="4"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Estado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">ABIERTA<BR ALIGN="LEFT"/>EN_CURSO<BR ALIGN="LEFT"/>CERRADA<BR ALIGN="LEFT"/>CANCELADA<BR ALIGN="LEFT"/>-etiqueta: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+etiqueta(): String<BR ALIGN="LEFT"/>+permiteTransicionA(d: Estado): boolean<BR ALIGN="LEFT"/>+esTerminal(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Actor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«Externalizable»</FONT><BR/><B>Cliente</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-id: int<BR ALIGN="LEFT"/>-nombre: String<BR ALIGN="LEFT"/>-correo: String<BR ALIGN="LEFT"/>-nivel: Nivel<BR ALIGN="LEFT"/><U>-CORREO: Pattern</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+Cliente()<BR ALIGN="LEFT"/>+Cliente(id, nombre, correo, nivel)<BR ALIGN="LEFT"/>+Cliente(id, nombre, correo)<BR ALIGN="LEFT"/>+id() / nombre() / correo() / nivel()<BR ALIGN="LEFT"/>+setNombre(n) / setCorreo(c) / setNivel(n) «final»<BR ALIGN="LEFT"/>+writeExternal(out)<BR ALIGN="LEFT"/>+readExternal(in)<BR ALIGN="LEFT"/>+equals / hashCode / toString<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Txn [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«Serializable, Iterable&lt;Linea&gt;»</FONT><BR/><B>OrdenServicio</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-id: int<BR ALIGN="LEFT"/>-cliente: Cliente<BR ALIGN="LEFT"/>-fecha: LocalDate<BR ALIGN="LEFT"/>-estado: Estado<BR ALIGN="LEFT"/>-lineas: List&lt;Linea&gt;<BR ALIGN="LEFT"/><U>-SECUENCIA: AtomicInteger</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+OrdenServicio(cliente)<BR ALIGN="LEFT"/>+OrdenServicio(id, cliente, fecha)<BR ALIGN="LEFT"/>+id() / cliente() / fecha()<BR ALIGN="LEFT"/>+estado(): Estado «sync»<BR ALIGN="LEFT"/>+agregar(e: Concepto, u: int): Linea «sync»<BR ALIGN="LEFT"/>+quitar(c: Folio): boolean «sync»<BR ALIGN="LEFT"/>+cambiarEstado(d: Estado) «sync»<BR ALIGN="LEFT"/>+iniciar() / cerrar() / cancelar()<BR ALIGN="LEFT"/>+restaurarEstado(e: Estado) «sync»<BR ALIGN="LEFT"/>+lineas(): List&lt;Linea&gt; «sync»<BR ALIGN="LEFT"/>+subtotal(): double «sync»<BR ALIGN="LEFT"/>+total(): double «sync»<BR ALIGN="LEFT"/>+diasDesde(hoy: LocalDate): long<BR ALIGN="LEFT"/>+iterator(): Iterator&lt;Linea&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Linea [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«inner final»</FONT><BR/><B>OrdenServicio.Linea</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-elemento: Concepto<BR ALIGN="LEFT"/>-unidades: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-Linea(e, u)<BR ALIGN="LEFT"/>+elemento(): Concepto<BR ALIGN="LEFT"/>+unidades(): int<BR ALIGN="LEFT"/>+subtotal(): double<BR ALIGN="LEFT"/>+importe(): double<BR ALIGN="LEFT"/>+contenedor(): OrdenServicio<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Cat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«Serializable, Iterable&lt;Concepto&gt;»</FONT><BR/><B>CatalogoConceptos</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-elementos: Map&lt;Folio, Concepto&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+CatalogoConceptos(iniciales: Concepto...)<BR ALIGN="LEFT"/>+agregar(nuevos: Concepto...) «final»<BR ALIGN="LEFT"/>+buscar(c: Folio): Optional&lt;Concepto&gt;<BR ALIGN="LEFT"/>+retirar(c: Folio): boolean<BR ALIGN="LEFT"/>+tamanio(): int<BR ALIGN="LEFT"/>+filtrar(r: Regla): List<BR ALIGN="LEFT"/>+deTipo(t: Class&lt;E&gt;): List&lt;E&gt;<BR ALIGN="LEFT"/>+ordenados(c: Comparator): List<BR ALIGN="LEFT"/><U>+porTarifa(u: int): Comparator «anónima»</U><BR ALIGN="LEFT"/>+resumen(): String «clase local»<BR ALIGN="LEFT"/>+iterator(): Iterator&lt;Concepto&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Iter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«private inner»</FONT><BR/><B>CatalogoConceptos.Iterador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-instantanea: List&lt;Concepto&gt;<BR ALIGN="LEFT"/>-cursor: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+hasNext(): boolean<BR ALIGN="LEFT"/>+next(): Concepto<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ItIf [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Iterator&lt;Concepto&gt;</B></TD></TR></TABLE>>];
  Acum [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«clase local»</FONT><BR/><B>Acumulador (en resumen())</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">cuenta, suma, mínimo, máximo<BR ALIGN="LEFT"/></TD></TR><TR><TD></TD></TR></TABLE>>];
  Regla [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FCE7F3" CELLPADDING="4"><FONT POINT-SIZE="9">«functional interface»</FONT><BR/><B>Regla&lt;T&gt;</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+evaluar(t: T): boolean</I><BR ALIGN="LEFT"/>+y(o) / o(o) / negar() «default»<BR ALIGN="LEFT"/>+comoPredicado(): Predicate&lt;T&gt; «default»<BR ALIGN="LEFT"/><U>+todas(): Regla</U><BR ALIGN="LEFT"/><U>+de(p: Predicate): Regla</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Reglas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«utilidad»</FONT><BR/><B>Reglas</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+precioHasta(max): Regla&lt;Concepto&gt;</U><BR ALIGN="LEFT"/><U>+nombreContiene(texto): Regla&lt;Concepto&gt;</U><BR ALIGN="LEFT"/><U>+conCapacidad(c: Class): Regla&lt;Concepto&gt;</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Fab [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FCE7F3" CELLPADDING="4"><FONT POINT-SIZE="9">«functional interface»</FONT><BR/><B>FabricaElemento&lt;E extends Concepto, A&gt;</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+crear(nombre, precio, atributo: A): E</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RNE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«exception»</FONT><BR/><B>ReglaNegocioException</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+ReglaNegocioException(mensaje)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RTE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«clase»</FONT><BR/><B>RuntimeException</B></TD></TR></TABLE>>];
  Contrato -> Base [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  Base -> S1 [dir=back, arrowtail=empty, arrowhead=none, style=solid];
  Base -> S2 [dir=back, arrowtail=empty, arrowhead=none, style=solid];
  Base -> S3 [dir=back, arrowtail=empty, arrowhead=none, style=solid];
  CAP1 -> S1 [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  CAP2 -> S2 [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  CAP1 -> S3 [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  CAP2 -> S3 [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  Base -> S1 [dir=back, arrowtail=odot, arrowhead=none, style=solid, color="#64748B", constraint=false];
  Contrato -> Clave [arrowhead=vee, style=dashed, label=" usa", fontsize=9];
  Base -> Clave [arrowhead=vee, headlabel="1", fontsize=9, label=" clave"];
  Txn -> Linea [dir=back, arrowtail=diamond, arrowhead=none, headlabel="1..*", taillabel="1", fontsize=9, label=" «inner»"];
  Linea -> Base [arrowhead=vee, headlabel="1", fontsize=9];
  Txn -> Actor [arrowhead=vee, headlabel="1", fontsize=9];
  Txn -> Estado [arrowhead=vee];
  Actor -> Nivel [arrowhead=vee];
  Cat -> Base [dir=back, arrowtail=odiamond, arrowhead=none, headlabel="0..*", fontsize=9];
  Cat -> Iter [dir=back, arrowtail=odot, arrowhead=none, style=solid, color="#64748B"];
  ItIf -> Iter [dir=back, arrowtail=empty, arrowhead=none, style=dashed];
  Cat -> Acum [arrowhead=vee, style=dashed, label=" local", fontsize=9];
  Cat -> Regla [arrowhead=vee, style=dashed];
  Reglas -> Regla [arrowhead=vee, style=dashed, label=" crea", fontsize=9];
  Reglas -> Base [arrowhead=vee, style=dashed];
  Fab -> Base [arrowhead=vee, style=dashed, label=" crea", fontsize=9];
  Base -> RNE [arrowhead=vee, style=dashed, label=" lanza", fontsize=9];
  Txn -> RNE [arrowhead=vee, style=dashed, label=" lanza", fontsize=9];
  RTE -> RNE [dir=back, arrowtail=empty, arrowhead=none, style=solid];
}
