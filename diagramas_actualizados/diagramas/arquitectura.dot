  Cont [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DCFCE7" CELLPADDING="4"><FONT POINT-SIZE="9">«record miembro»</FONT><BR/><B>Respaldo.Contenido</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">encabezado: String<BR ALIGN="LEFT"/>fecha: LocalDateTime<BR ALIGN="LEFT"/>catalogo: CatalogoConceptos<BR ALIGN="LEFT"/>clientes: List&lt;Cliente&gt;<BR ALIGN="LEFT"/>registros: List&lt;OrdenServicio&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD></TD></TR></TABLE>>];
  Dom [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="9">«paquete modelo»</FONT><BR/><B>Modelo de dominio</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">CatalogoConceptos<BR ALIGN="LEFT"/>OrdenServicio (+Linea)<BR ALIGN="LEFT"/>Cliente · Nivel · Estado<BR ALIGN="LEFT"/>Folio · Cotizable<BR ALIGN="LEFT"/>Concepto (+3 subtipos)<BR ALIGN="LEFT"/>ReglaNegocioException<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Fun [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="4"><FONT POINT-SIZE="9">«paquete funcional»</FONT><BR/><B>Programación funcional</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">Regla&lt;T&gt; · Reglas<BR ALIGN="LEFT"/>FabricaElemento&lt;E,A&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  DB [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#E2E8F0" CELLPADDING="4"><FONT POINT-SIZE="9">«base de datos»</FONT><BR/><B>SQLite (.db)</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">concepto<BR ALIGN="LEFT"/>cliente<BR ALIGN="LEFT"/>orden<BR ALIGN="LEFT"/>orden_linea<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
