digraph G {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.55, fontname="Helvetica", dpi=170, bgcolor="white"];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", color="#334155"];
  UI [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#E0E7FF" CELLPADDING="4"><FONT POINT-SIZE="9">«paquete ui»</FONT><BR/><B>Capa de presentación (libre)</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">JavaFX | Swing | Spring Boot | Javalin | Vaadin | ...<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  VP [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#E0E7FF" CELLPADDING="4"><FONT POINT-SIZE="9">«ui · Swing + FlatLaf»</FONT><BR/><B>VentanaPrincipal</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-taller: Taller<BR ALIGN="LEFT"/>-oyente: OyenteEvento<BR ALIGN="LEFT"/>-seccion: String<BR ALIGN="LEFT"/>-oscuro: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+VentanaPrincipal(taller: Taller)<BR ALIGN="LEFT"/>-vistaInicio/Clientes/Conceptos/Ordenes()<BR ALIGN="LEFT"/>-vistaReportes/Monitor/Respaldo()<BR ALIGN="LEFT"/>-exportarCsv() / exportarRespaldo()<BR ALIGN="LEFT"/>-ejecutar(op: AccionUI, ok: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  VPi [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#E0E7FF" CELLPADDING="4"><FONT POINT-SIZE="9">«private»</FONT><BR/><B>VentanaPrincipal.AccionUI / ClienteOpcion / ConceptoOpcion</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">«functional» ejecutar() throws Exception<BR ALIGN="LEFT"/>«record» ClienteOpcion(id, nombre)<BR ALIGN="LEFT"/>«record» ConceptoOpcion(clave, nombre)<BR ALIGN="LEFT"/>PanelRedondeado, BannerPanel<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AppN [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«app»</FONT><BR/><B>App</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+main(args)  «invokeLater»</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  DemoN [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«app»</FONT><BR/><B>DemoModelo / PruebasModelo</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+main(args)</U><BR ALIGN="LEFT"/>-Caso «interface» (PruebasModelo)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  G [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FEF3C7" CELLPADDING="4"><FONT POINT-SIZE="9">«fachada» · AutoCloseable</FONT><BR/><B>Taller</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+PLAZO_DIAS = 5</U><BR ALIGN="LEFT"/>-catalogo: CatalogoConceptos<BR ALIGN="LEFT"/>-clientes: Map&lt;Integer, Cliente&gt;<BR ALIGN="LEFT"/>-registros: Map&lt;Integer, OrdenServicio&gt;<BR ALIGN="LEFT"/>-alertados: Set&lt;Integer&gt;<BR ALIGN="LEFT"/>-reloj: Supplier&lt;LocalDate&gt;<BR ALIGN="LEFT"/>-oyentes: List&lt;OyenteEvento&gt;<BR ALIGN="LEFT"/>-repoElementos / repoClientes / repoRegistros<BR ALIGN="LEFT"/>-monitor: MonitorAvance<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+Taller(bd) / Taller(bd, reloj)<BR ALIGN="LEFT"/>+registrar(f: FabricaElemento&lt;E,A&gt;, ...): E<BR ALIGN="LEFT"/>+actualizar(e, nombre, precio) / retirar(c): boolean<BR ALIGN="LEFT"/>+catalogo() / elemento(clave)<BR ALIGN="LEFT"/>+registrarCliente(...): Cliente<BR ALIGN="LEFT"/>+cambiarNivel(id, n) / actualizarCliente(...)<BR ALIGN="LEFT"/>+cliente(id) / clientes() / eliminarCliente(id)<BR ALIGN="LEFT"/>+abrir(id): OrdenServicio<BR ALIGN="LEFT"/>+agregarLinea(id, clave, u) / quitarLinea(id, clave)<BR ALIGN="LEFT"/>+iniciar/cerrar/cancelar(id)<BR ALIGN="LEFT"/>+registro(id) / registros() / registrosEn(e)<BR ALIGN="LEFT"/>+ingresosPorTipo(): Map<BR ALIGN="LEFT"/>+masDemandado(): Optional<BR ALIGN="LEFT"/>+mejores(n): List<BR ALIGN="LEFT"/>+estadisticas(): DoubleSummaryStatistics<BR ALIGN="LEFT"/>+particionarPorPrecio(u) / conteoPorEstado()<BR ALIGN="LEFT"/>+buscar(r: Regla) / proyectar(f: Function)<BR ALIGN="LEFT"/>+describir(e): String «pattern matching»<BR ALIGN="LEFT"/>+revisar(): int «sync»<BR ALIGN="LEFT"/>+iniciarMonitor(ms) / detenerMonitor()<BR ALIGN="LEFT"/>+monitorActivo(): boolean<BR ALIGN="LEFT"/>+suscribir(o) / desuscribir(o)<BR ALIGN="LEFT"/>+exportarRespaldo(p: Path) / close()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Mon [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FEF3C7" CELLPADDING="4"><FONT POINT-SIZE="9">«inner final»</FONT><BR/><B>Taller.MonitorAvance</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-MonitorAvance(periodoMs)<BR ALIGN="LEFT"/>#ejecutarCiclo() → Taller.this.revisar()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Tarea [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FCE7F3" CELLPADDING="4"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>TareaPeriodica</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-periodoMs: long<BR ALIGN="LEFT"/>-activa: boolean «volatile»<BR ALIGN="LEFT"/>-hilo: Thread<BR ALIGN="LEFT"/>-ciclos: long «volatile»<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">#TareaPeriodica(periodoMs)<BR ALIGN="LEFT"/>+iniciar(nombre) «sync»<BR ALIGN="LEFT"/>+detener() «interrupt + join»<BR ALIGN="LEFT"/>+activa(): boolean<BR ALIGN="LEFT"/>+ciclos(): long<BR ALIGN="LEFT"/>+run() «final»<BR ALIGN="LEFT"/><I>#ejecutarCiclo()</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Run [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Runnable</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+run()</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Oy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#FCE7F3" CELLPADDING="4"><FONT POINT-SIZE="9">«functional interface»</FONT><BR/><B>OyenteEvento</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+notificar(e: Evento)</I><BR ALIGN="LEFT"/>+luego(o): OyenteEvento «default»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Ev [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DCFCE7" CELLPADDING="4"><FONT POINT-SIZE="9">«record»</FONT><BR/><B>Evento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">tipo: TipoEvento<BR ALIGN="LEFT"/>mensaje: String<BR ALIGN="LEFT"/>instante: LocalDateTime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>+de(tipo, mensaje): Evento</U><BR ALIGN="LEFT"/>+toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  TE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DCFCE7" CELLPADDING="4"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>TipoEvento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">ALTA<BR ALIGN="LEFT"/>CAMBIO_ESTADO<BR ALIGN="LEFT"/>ALERTA<BR ALIGN="LEFT"/>CANCELACION_AUTOMATICA<BR ALIGN="LEFT"/></TD></TR><TR><TD></TD></TR></TABLE>>];
  Repo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B>Repositorio&lt;T, K&gt;</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+guardar(t: T)</I><BR ALIGN="LEFT"/><I>+buscar(k: K): Optional&lt;T&gt;</I><BR ALIGN="LEFT"/><I>+todos(): List&lt;T&gt;</I><BR ALIGN="LEFT"/><I>+eliminar(k: K): boolean</I><BR ALIGN="LEFT"/>+existe(k: K): boolean «default»<BR ALIGN="LEFT"/>+guardarTodos(it: Iterable&lt;T&gt;) «default»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Map [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«interface miembro»</FONT><BR/><B>Repositorio.MapeadorFila&lt;R&gt;</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+mapear(rs: ResultSet): R</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><B>RepositorioConceptoSQLite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>-RECONSTRUCTORES: Map&lt;String, Reconstructor&gt;</U><BR ALIGN="LEFT"/>-bd: ConexionSQLite<BR ALIGN="LEFT"/>-mapeador: MapeadorFila&lt;Concepto&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>~atributoDe(e): String «switch sellado»</U><BR ALIGN="LEFT"/>+guardar / buscar / todos / eliminar<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Rec [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«private interface»</FONT><BR/><B>RepositorioConceptoSQLite.Reconstructor</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+reconstruir(clave, nombre, precio, atributo): Concepto<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><B>RepositorioClienteSQLite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-bd: ConexionSQLite<BR ALIGN="LEFT"/>-mapeador: MapeadorFila&lt;Cliente&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+guardar / buscar / todos / eliminar<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><B>RepositorioOrdenServicioSQLite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">-bd: ConexionSQLite<BR ALIGN="LEFT"/>-clientes: Repositorio&lt;Cliente, Integer&gt;<BR ALIGN="LEFT"/>-elementos: Repositorio&lt;Concepto, Folio&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+guardar(t) «transacción»<BR ALIGN="LEFT"/>-reconstruir(c, rs): OrdenServicio<BR ALIGN="LEFT"/>+buscar / todos / eliminar<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Cx [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«AutoCloseable»</FONT><BR/><B>ConexionSQLite</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><U>-ESQUEMA: String[]</U><BR ALIGN="LEFT"/>-conexion: Connection<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">«static {}» carga org.sqlite.JDBC<BR ALIGN="LEFT"/>+ConexionSQLite(ruta)<BR ALIGN="LEFT"/>+conexion(): Connection<BR ALIGN="LEFT"/>+enTransaccion(t: TrabajoSQL&lt;R&gt;): R<BR ALIGN="LEFT"/>+close()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  TS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#DBEAFE" CELLPADDING="4"><FONT POINT-SIZE="9">«functional interface miembro»</FONT><BR/><B>ConexionSQLite.TrabajoSQL&lt;R&gt;</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><I>+ejecutar(c: Connection): R  throws SQLException</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#334155"><TR><TD BGCOLOR="#F1F5F9" CELLPADDING="4"><FONT POINT-SIZE="9">«exception»</FONT><BR/><B>PersistenciaException</B></TD></TR><TR><TD></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3">+PersistenciaException(mensaje, causa)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
